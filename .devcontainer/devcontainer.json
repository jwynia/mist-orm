{
  "name": "Node.js & TypeScript",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers-community/features/deno:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/rails/devcontainer/features/postgres-client:1.1.3": {}
  },
  "containerEnv": {
    "XDG_CONFIG_HOME": "/workspaces/${localWorkspaceFolderBasename}/.agents/config",
    "XDG_DATA_HOME": "/workspaces/${localWorkspaceFolderBasename}/.agents/data",
    "XDG_CACHE_HOME": "/workspaces/${localWorkspaceFolderBasename}/.agents/cache",
    "XDG_STATE_HOME": "/workspaces/${localWorkspaceFolderBasename}/.agents/state",
    "CLAUDE_CONFIG_DIR": "/workspaces/${localWorkspaceFolderBasename}/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": ["saoudrizwan.claude-dev", "Anthropic.claude-code"]
    }
  },
  "postCreateCommand": "sudo npm i -g @anthropic-ai/claude-code && sudo npm i @ast-grep/cli -g && sudo npm i -g opencode-ai"
}
